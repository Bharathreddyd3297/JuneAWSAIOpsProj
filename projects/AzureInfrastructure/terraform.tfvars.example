# Copy to terraform.tfvars for local execution. Never commit credentials.
subscription_id     = "00000000-0000-0000-0000-000000000000"
location            = "centralindia"
resource_group_name = "telugu-pickles-azure"
cluster_name        = "telugu-pickles-aks"
gitops_repo_url     = "https://github.com/ramakrishnaredd95-stack/JuneAWSAIOpsProj.git"
aiops_enabled       = true
aiops_location      = "eastus2"
aiops_model_name    = "gpt-4o"
aiops_model_version = "2024-11-20"

# Add your Entra user/group object ID to retain local AKS administrator access.
aks_admin_principal_ids = ["00000000-0000-0000-0000-000000000000"]
